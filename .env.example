# ─────────────────────────────────────────────────────────────
# DJR® · Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# Nunca subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# true  → la tienda usa los datos de demostración de lib/mock-data.ts
# false → la tienda consulta la Shopify Storefront API (requiere las variables siguientes)
USE_MOCK_DATA=true

# URL pública del sitio (metadatos, Open Graph, sitemap). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Shopify Storefront API (solo servidor) ───────────────────
# Dominio de la tienda, sin https:// (p. ej. djr.myshopify.com)
SHOPIFY_STORE_DOMAIN=[REEMPLAZAR].myshopify.com

# Token PRIVADO de Storefront API (Headless channel / Hydrogen).
# Se envía solo desde el servidor en la cabecera Shopify-Storefront-Private-Token.
# NO uses el prefijo NEXT_PUBLIC_: quedaría expuesto en el navegador.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=[REEMPLAZAR]

# Versión de la Storefront API. Verifica la última versión estable en
# https://shopify.dev/docs/api/usage/versioning
SHOPIFY_STOREFRONT_API_VERSION=2026-07
